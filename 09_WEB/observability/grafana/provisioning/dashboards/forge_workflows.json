{
  "uid": "forge-workflows",
  "title": "Forge — Workflows & Agents (tokens, latence, hallucinations)",
  "tags": ["forge", "n8n", "observability"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Tokens input / output par workflow",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (workflow) (forge_wf_tokens_input_total)",
          "legendFormat": "{{workflow}} — in"
        },
        {
          "refId": "B",
          "expr": "sum by (workflow) (forge_wf_tokens_output_total)",
          "legendFormat": "{{workflow}} — out"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Tokens inference (thinking)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (workflow, agent) (forge_wf_tokens_inference_total)",
          "legendFormat": "{{workflow}}/{{agent}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latence p50 / p95 (ms)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 10000 },
              { "color": "red", "value": 30000 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "forge_wf_latency_p50_ms", "legendFormat": "p50 {{workflow}}/{{agent}}" },
        { "refId": "B", "expr": "forge_wf_latency_p95_ms", "legendFormat": "p95 {{workflow}}/{{agent}}" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Score hallucination moyen (1 = groundé, alerte < 0.7)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.7 },
              { "color": "green", "value": 0.85 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "forge_wf_hallucination_avg", "legendFormat": "{{workflow}}/{{agent}}" }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Affirmations contredites (conflits RAG↔KAG)",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(forge_wf_hallucination_contradicted_total)",
          "legendFormat": "contredites"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Taux d'erreur par agent (alerte > 20 %)",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.2 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "forge_wf_error_rate", "legendFormat": "{{workflow}}/{{agent}}" }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Coût cumulé (USD)",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 4 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(forge_wf_cost_usd_total)", "legendFormat": "total" }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Appels par workflow / agent",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 },
      "options": { "showHeader": true },
      "targets": [
        { "refId": "A", "expr": "forge_wf_calls_total", "format": "table", "instant": true }
      ]
    }
  ]
}
