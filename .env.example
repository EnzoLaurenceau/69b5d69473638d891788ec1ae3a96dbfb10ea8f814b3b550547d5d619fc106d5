# .env.example — variables d'environnement de la plateforme d'inférence (Phase 4).
# Copier en `.env` (jamais commité, cf. .gitignore) et renseigner les VRAIES valeurs.
# `docker-compose.prod.yml` refuse de démarrer si les variables marquées (requis) manquent.

# ── Datastores ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me-strong-password        # (requis) mot de passe PostgreSQL
# DATABASE_URL / REDIS_URL sont fixés par le compose (réseau interne) — ne pas surcharger.

# ── Auth produit ──────────────────────────────────────────────────────────────
WEB_SECRET=change-me-legacy-web-secret             # secret historique du dashboard server.py
FORGE_ADMIN_TOKEN=change-me-operator-token         # (requis) jeton OPÉRATEUR (≠ jeton tenant) : ouvre /v1/admin/*
FORGE_CORS_ORIGINS=https://console.exemple.com     # (requis) origines autorisées (liste séparée par des virgules)

# ── Rappels de sécurité (NE PAS définir en prod) ──────────────────────────────
# FORGE_SINGLE_TENANT=local        # opt-in mono-tenant local UNIQUEMENT (contourne l'auth Bearer)
# FORGE_WEB_ALLOW_INSECURE=1       # opt-in insécurité local UNIQUEMENT

# ── LLM FREE (génération automatisée — doctrine LLM PRIORITY, jamais d'API Anthropic au token) ──
# MIMO_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# CEREBRAS_API_KEY=
